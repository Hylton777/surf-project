# Copy to `.env.local` — do not commit secrets.

# AI (Cloudflare Workers AI — used by /api/anthropic/messages in dev & Vercel)
# Token: Cloudflare dashboard → Workers AI → Use REST API
# Account ID: right sidebar on any zone
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_GATEWAY_ID=default
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-70b-instruct

# Auth & saved preferences (optional — run supabase/*.sql in SQL editor first)
REACT_APP_SUPABASE_URL=https://YOUR_REF.supabase.co
REACT_APP_SUPABASE_ANON_KEY=

# Drive times (TomTom) + default start location
VITE_TOMTOM_API_KEY=
VITE_DRIVE_ORIGIN=San Francisco, CA

# --- Optional ---
# CLOUDFLARE_SPOT_CONFIG_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8-fast
# CLOUDFLARE_FALLBACK_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8-fast
# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY  (aliases for REACT_APP_* above)
# ANTHROPIC_API_KEY=   (only if Cloudflare vars are unset — direct Anthropic)
# ANTHROPIC_DNS_SERVERS=8.8.8.8,1.1.1.1
# VITE_ANTHROPIC_PROXY_URL=
