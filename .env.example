# Copy to `.env.local` (never commit `.env.local`).
# Get a key at https://console.anthropic.com/
# Server-side key used by Vite dev middleware, `server/anthropic-proxy.mjs`, and Vercel (`api/anthropic/messages.js`).
# On Vercel: add the same name under Project → Settings → Environment Variables (Sensitive). No `VITE_` prefix.
# Production uses `api/anthropic/messages.js` (same URL as local dev: POST /api/anthropic/messages).
ANTHROPIC_API_KEY=

# Optional: override DNS for the Anthropic proxy only (Vite dev + standalone proxy). If unset, 8.8.8.8 and
# 1.1.1.1 are appended after your system resolvers so api.anthropic.com still resolves when LAN/VPN DNS fails.
# ANTHROPIC_DNS_SERVERS=8.8.8.8,1.1.1.1

# Optional: for preview/prod, point client to an external proxy (full URL to the Messages endpoint).
# Example standalone: http://127.0.0.1:8787/v1/messages (bare http://127.0.0.1:8787 is normalized to this).
# If omitted in dev, app defaults to /api/anthropic/messages.
VITE_ANTHROPIC_PROXY_URL=

# Optional: choose model your Anthropic account can access.
# Testing default = cheapest available (Haiku):
VITE_ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional fallback model if primary is unavailable.
VITE_ANTHROPIC_FALLBACK_MODEL=claude-sonnet-4-6

# Optional: model for the tiny “surf spot name → US ZIP” step when adding a custom spot.
# If unset, VITE_ANTHROPIC_MODEL is used.
# VITE_ANTHROPIC_SPOT_ZIP_MODEL=claude-haiku-4-5-20251001

# TomTom API key used to fetch drive times per spot.
VITE_TOMTOM_API_KEY=

# Optional origin used for drive-time calculations.
VITE_DRIVE_ORIGIN=San Francisco, CA
