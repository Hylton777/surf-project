# Copy to `.env.local` (never commit `.env.local`).

# ── Workers AI via Cloudflare (recommended — uses startup / neuron credits) ──
# API token: Workers AI → Use REST API, or custom token (Workers AI + AI Gateway).
# Account ID: Cloudflare dashboard → right sidebar on any zone.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_GATEWAY_ID=default
# All AI calls use this @cf model (server overrides client model when set):
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-70b-instruct
# If your host strips "@", cf/meta/llama-3.1-70b-instruct also works (auto-normalized).
# Optional: different model for “add spot” JSON (defaults to CLOUDFLARE_MODEL)
# CLOUDFLARE_SPOT_CONFIG_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8-fast
# Optional second @cf model if the primary fails (must stay @cf/* — no Claude fallback)
# CLOUDFLARE_FALLBACK_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8-fast

# ── Claude via Cloudflare gateway (omit CLOUDFLARE_MODEL or use claude-* ids) ─
# VITE_ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# VITE_ANTHROPIC_FALLBACK_MODEL=claude-sonnet-4-5

# ── Direct Anthropic (legacy — only if Cloudflare vars are not set) ───────────
# ANTHROPIC_API_KEY=

# Optional: override DNS for the AI proxy only (Vite dev + standalone proxy).
# ANTHROPIC_DNS_SERVERS=8.8.8.8,1.1.1.1

# Client calls POST /api/anthropic/messages (path unchanged). Vite exposes CLOUDFLARE_MODEL to the client.
# Optional external proxy URL for preview/prod builds:
# VITE_ANTHROPIC_PROXY_URL=

# Supabase (auth) — Project Settings → API → Project URL (NOT the /rest/v1 path).
REACT_APP_SUPABASE_URL=https://YOUR_REF.supabase.co
# anon public key (or publishable key) from the same API page
REACT_APP_SUPABASE_ANON_KEY=
# After first deploy: run supabase/user_profiles.sql in the Supabase SQL editor for saved preferences.


# TomTom API key used to fetch drive times per spot.
VITE_TOMTOM_API_KEY=

# Optional origin used for drive-time calculations.
VITE_DRIVE_ORIGIN=San Francisco, CA
