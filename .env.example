# Copy to `.env.local` (never commit `.env.local`).
# Get a key at https://console.anthropic.com/
# Server-side key used by Vite middleware / local proxy.
ANTHROPIC_API_KEY=

# Optional: for preview/prod, point client to an external proxy endpoint.
# If omitted in dev, app defaults to /api/anthropic/messages.
VITE_ANTHROPIC_PROXY_URL=

# Optional: choose model your Anthropic account can access.
# Testing default = cheapest available (Haiku):
VITE_ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional fallback model if primary is unavailable.
VITE_ANTHROPIC_FALLBACK_MODEL=claude-sonnet-4-6

# TomTom API key used to fetch drive times per spot.
VITE_TOMTOM_API_KEY=

# Optional origin used for drive-time calculations.
VITE_DRIVE_ORIGIN=San Francisco, CA
