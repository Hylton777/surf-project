# Copy to `.env.local` (never commit `.env.local`).

# ── Claude via Cloudflare AI Gateway (recommended) ─────────────────────────────
# Create a token at https://dash.cloudflare.com/profile/api-tokens with "AI Gateway" permission.
# Account ID: Cloudflare dashboard → any zone → right sidebar, or Workers & Pages overview.
# Optional: AI Gateway ID from AI → AI Gateway → your gateway (for routing/analytics).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_AI_GATEWAY_ID=

# ── Direct Anthropic (legacy fallback if Cloudflare vars are not set) ───────
# ANTHROPIC_API_KEY=

# Optional: override DNS for the Claude proxy only (Vite dev + standalone proxy).
# ANTHROPIC_DNS_SERVERS=8.8.8.8,1.1.1.1

# Client always calls your app proxy in dev: POST /api/anthropic/messages
# Optional external proxy URL for preview/prod builds:
# VITE_ANTHROPIC_PROXY_URL=

# Models (Anthropic-style ids; Cloudflare requests map to anthropic/... automatically)
VITE_ANTHROPIC_MODEL=claude-haiku-4-5-20251001
VITE_ANTHROPIC_FALLBACK_MODEL=claude-sonnet-4-6
# VITE_ANTHROPIC_SPOT_CONFIG_MODEL=claude-haiku-4-5-20251001

# TomTom API key used to fetch drive times per spot.
VITE_TOMTOM_API_KEY=

# Optional origin used for drive-time calculations.
VITE_DRIVE_ORIGIN=San Francisco, CA
